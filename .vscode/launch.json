{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug rview",
            "cargo": {
                "args": ["build", "--bin=rview"],
                "filter": {
                    "name": "rview",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Release rview",
            "cargo": {
                "args": ["build", "--bin=rview", "--release"],
                "filter": {
                    "name": "rview",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}
